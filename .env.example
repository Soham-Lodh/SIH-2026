# Groq API keys can be split by workload to keep quota isolation clean.
# Each section falls back to GROQ_API_KEY if a dedicated key is not set.
GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_API_KEY_PAST="MY_GROQ_API_KEY_FOR_PAST_ARCHIVE_AND_COMPARISONS"
GROQ_API_KEY_PAST_FILTERS="MY_GROQ_API_KEY_FOR_PAST_FILTERED_QUERIES"
GROQ_API_KEY_CHAT="MY_GROQ_API_KEY_FOR_CHAT"
GROQ_API_KEY_STT="MY_GROQ_API_KEY_FOR_SPEECH_TO_TEXT"
GROQ_API_KEY_TTS="MY_GROQ_API_KEY_FOR_TEXT_TO_SPEECH"

# Optional model overrides. Set these if you want to pin a different model.
GROQ_MODEL="llama-3.3-70b-versatile"
GROQ_STT_MODEL="whisper-large-v3-turbo"
GROQ_TTS_MODEL="canopylabs/orpheus-v1-english"
GROQ_TTS_VOICE="austin"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
